// Draft. The Stream service as a System Nexus service, for the Streams API proposal. Each record
// maps to a message of the protos under ../temporal/api (stream/v1, streamservice/v1 and the
// Stream enums in enums/v1). This file is the source. Each SDK copies it and generates its Workflow
// API and its client with nexgen (`--targets workflow,client --system-nexus`).
package temporal:nexus@1.0.0;

world system {
  export stream-service;
}

/// @nexus.endpoint "__temporal_system"
/// @nexus.service-name "temporal.api.streamservice.v1.StreamService"
/// @nexus.experimental
interface stream-service {
  use nexus:temporal-types/model@1.0.0.{
    duration,
    placeholder,
  };

  /// The value type of a Stream's Records. A call's type argument sets it.
  /// @nexus.type-parameter
  type body-t = placeholder;

  /// @nexus.proto "google.protobuf.Timestamp"
  record timestamp {
    seconds: option<s64>,
    nanos: option<s32>,
  }

  /// @nexus.doc "Identifies one Stream. The id is opaque to callers."
  /// @nexus.proto "temporal.api.stream.v1.StreamRef"
  record stream-ref {
    /// @nexus.doc "The Stream id, 1 to 4096 bytes."
    id: string,
    /// @nexus.doc "The run chain or Standalone Activity of a bound Stream. Empty if standalone."
    owner: option<execution>,
    /// @nexus.doc "Registered backend name, empty for the default. The Store never reads it."
    backend: option<string>,
  }

  /// @nexus.proto "temporal.api.enums.v1.ExecutionType"
  enum execution-type {
    /// @nexus.fallback
    execution-type-unspecified,
    execution-type-workflow,
    execution-type-activity,
    execution-type-nexus-operation,
  }

  /// @nexus.doc "A Workflow run chain or a Standalone Activity run."
  /// @nexus.proto "temporal.api.common.v1.Execution"
  record execution {
    %type: option<execution-type>,
    /// @nexus.doc "The Workflow id, or the Standalone Activity's id."
    business-id: option<string>,
    /// @nexus.doc "The run chain's first run id, or the Standalone Activity's run id."
    run-id: option<string>,
  }

  /// @nexus.doc "A Workflow Task attempt of the run."
  /// @nexus.proto "temporal.api.stream.v1.WorkflowTaskEpoch"
  record workflow-task-epoch {
    started-event-id: option<s64>,
    attempt: option<s32>,
    /// @nexus.doc "When the Workflow Task attempt started. It tells a reused started id apart."
    started-time: option<timestamp>,
  }

  /// @nexus.doc "A Local Activity attempt. Its Workflow Task orders it first."
  /// @nexus.proto "temporal.api.stream.v1.LocalActivityEpoch"
  record local-activity-epoch {
    /// @nexus.doc "The Workflow Task attempt that dispatched the Local Activity."
    task: option<workflow-task-epoch>,
    /// @nexus.doc "The Local Activity's own attempt in that Workflow Task."
    attempt: option<s32>,
  }

  /// @nexus.doc "An Activity or Standalone Activity attempt."
  /// @nexus.proto "temporal.api.stream.v1.ActivityEpoch"
  record activity-epoch {
    /// @nexus.doc "When the server scheduled this attempt. A reset makes it later."
    attempt-scheduled-time: option<timestamp>,
    attempt: option<s32>,
  }

  /// @nexus.doc "A client attempt, which the client picks."
  /// @nexus.proto "temporal.api.stream.v1.ClientEpoch"
  record client-epoch {
    attempt: option<s32>,
  }

  // The case is the kind of the Producer, so a kind sets only its own fields.
  /// @nexus.doc "The epoch of each kind of Producer."
  /// @nexus.proto "temporal.api.stream.v1.ProducerEpoch.kind"
  variant producer-epoch-kind {
    workflow(workflow-task-epoch),
    local-activity(local-activity-epoch),
    activity(activity-epoch),
    standalone-activity(activity-epoch),
    client(client-epoch),
  }

  /// @nexus.doc "The ordered attempt of a Producer. A higher epoch supersedes a lower one."
  /// @nexus.proto "temporal.api.stream.v1.ProducerEpoch"
  record producer-epoch {
    // A newer server can send a kind that this SDK doesn't know. Then the kind is empty.
    kind: option<producer-epoch-kind>,
  }

  /// @nexus.doc "The Producer of a batch."
  /// @nexus.proto "temporal.api.stream.v1.Producer"
  record producer {
    /// @nexus.doc "Stable across attempts, such as wf:<run id> for a Workflow run."
    id: string,
    /// @nexus.doc "Required. Its case gives the kind of the Producer."
    epoch: option<producer-epoch>,
    /// @nexus.doc "The run of the Producer, so nobody parses the id. Empty for a client."
    run-id: option<string>,
  }

  /// @nexus.doc "One Record to append."
  /// @nexus.proto "temporal.api.stream.v1.AppendRecord"
  /// @nexus.unwrap
  record append-record {
    /// @nexus.doc "The value."
    body: body-t,
  }

  // A Local Activity, Activity or Standalone Activity write withdraws the Records of its Producer
  // with a lower epoch. A Workflow write, with its task t and the previous completed task c,
  // withdraws the Records of the run and of its Local Activities whose Workflow Task is in
  // failed-tasks or strictly between c and t. It also withdraws those at the started event id of c
  // or of t with a lower epoch than c or t. No task in that range can have completed. A client
  // write withdraws nothing.
  /// @nexus.doc "The Producer of a write, and which earlier Records the write withdraws."
  /// @nexus.proto "temporal.api.stream.v1.StreamWriter"
  record stream-writer {
    /// @nexus.doc "Required on a write. Its epoch's case picks the withdrawal rule."
    producer: option<producer>,
    /// @nexus.doc "Workflow and Local Activity only. The run's last completed Workflow Task."
    previous-completed-task: option<workflow-task-epoch>,
    /// @nexus.doc "Workflow and Local Activity only. The run's failed or timed out Workflow Tasks."
    failed-tasks: list<s64>,
    /// @nexus.doc "Retry run only. The previous run, all of whose Records are withdrawn."
    withdraw-run: option<string>,
  }

  /// @nexus.doc "Which earlier Records a Superseded item withdraws."
  /// @nexus.proto "temporal.api.stream.v1.StreamSuperseded"
  record stream-superseded {
    /// @nexus.doc "The writer that withdraws. Its epoch is empty when only withdraw-run applies."
    writer: option<stream-writer>,
  }

  /// @nexus.doc "One Record that a Producer appended."
  /// @nexus.proto "temporal.api.stream.v1.StreamData"
  record stream-data {
    /// @nexus.doc "The value."
    body: body-t,
    producer: option<producer>,
  }

  // The read builds a Superseded item from a flagged batch.
  /// @nexus.doc "A read item: a Record or a Superseded item. A close writes no item."
  /// @nexus.proto "temporal.api.stream.v1.StreamRecord.item"
  variant stream-item {
    data(stream-data),
    superseded(stream-superseded),
  }

  // An offset is ordered and unique in one Stream, and sparse. Offsets have gaps, so they don't
  // count Records. A read gives its Stream, so the read checks the offset against that Stream.
  /// @nexus.doc "One item that a read gives."
  /// @nexus.proto "temporal.api.stream.v1.StreamRecord"
  record stream-record {
    // A newer server can send an item kind that this SDK doesn't know. Then the item is empty.
    item: option<stream-item>,
    /// @nexus.doc "The place of this item in the Stream. Ordered and unique, with gaps."
    offset: option<s64>,
  }

  /// @nexus.doc
  ///   "Create a Stream. If it exists, fail, or with use-existing get the open one."
  /// @nexus.proto "temporal.api.streamservice.v1.CreateStreamRequest"
  record create-stream-request {
    // Its field name isn't ref, so the created stream takes its ref from the response, which
    // carries the owner.
    /// @nexus.doc "The ref of the Stream to create. Its id is the Stream id."
    /// @nexus.flatten-in-api fields="id backend"
    stream-ref: stream-ref,
    /// @nexus.doc "The age after which a Record is dropped. Empty is the Store default."
    retention: option<duration>,
    // A wrong run would silently withdraw real Records, so it is never a parameter. The helper
    // gives the previous run in a retry run's Workflow, and nothing elsewhere.
    /// @nexus.doc "Retry run only. The previous run, whose Records this withdraws."
    /// @nexus.source targets="workflow" python="withdraw_run()" typescript="withdrawRun()"
    ///   dotnet="StreamWorkflowContext.WithdrawRun()"
    /// @nexus.source targets="client" python="withdraw_run()" typescript="withdrawRun()"
    ///   dotnet="StreamWorkflowContext.WithdrawRun()"
    withdraw-run: option<string>,
    // A bound Stream's owner. An SDK creates only standalone Streams for now.
    /// @nexus.omit
    owner: placeholder,
    /// @nexus.doc "What the create does when the Stream exists. Unspecified is fail."
    id-conflict-policy: option<stream-id-conflict-policy>,
    // A retry of the create that made the Stream sends the same id, so it doesn't fail as a
    // conflict. In a Workflow the helper gives a deterministic id.
    /// @nexus.doc "Unique for each create call, and the same on its retries."
    /// @nexus.source python="request_id()" typescript="requestId()"
    ///   dotnet="StreamWorkflowContext.RequestId()"
    request-id: option<string>,
    // Native only. The SDK Stores don't read it.
    /// @nexus.omit
    close-with-run: placeholder,
    /// @nexus.omit
    namespace: placeholder,
    // Native only. The SDK Stores don't read it.
    /// @nexus.omit
    task-token: placeholder,
  }

  /// What a create does when its Stream exists. Unspecified is fail.
  /// @nexus.proto "temporal.api.enums.v1.StreamIdConflictPolicy"
  enum stream-id-conflict-policy {
    stream-id-conflict-policy-unspecified,
    stream-id-conflict-policy-fail,
    stream-id-conflict-policy-use-existing,
  }

  /// @nexus.proto "temporal.api.enums.v1.StreamStatus"
  enum stream-status {
    /// @nexus.fallback
    stream-status-unspecified,
    stream-status-open,
    stream-status-closed,
    stream-status-expired,
  }

  /// @nexus.doc
  ///   "Append one batch. The Store keeps a resent batch once, by Producer, epoch and sequence."
  /// @nexus.proto "temporal.api.streamservice.v1.AppendRecordsRequest"
  record append-records-request {
    ref: stream-ref,
    records: list<append-record>,
    // A wrong run or task would silently withdraw real Records, so the writer is never a
    // parameter. The helper of each context fills only the fields that apply where it runs.
    /// @nexus.doc "Required outside a Workflow. In a Workflow the transport sets it."
    /// @nexus.source targets="workflow" python="workflow_writer()"
    ///   typescript="workflowWriter()" dotnet="StreamWorkflowContext.Writer()"
    /// @nexus.source targets="client" python="client_writer()" typescript="clientWriter()"
    ///   dotnet="StreamActivityContext.Writer()"
    writer: option<stream-writer>,
    // A call with no writer state, such as publish, sends no sequence. The Store then numbers the
    // batch, so nothing dedupes it.
    /// @nexus.doc
    ///   "The batch number in this epoch. Empty takes the next one, and a retry writes it again."
    sequence: option<s64>,
    /// @nexus.omit
    namespace: placeholder,
    // Native only. The SDK Stores don't read them.
    /// @nexus.omit
    defer-withdrawal: placeholder,
    /// @nexus.omit
    task-token: placeholder,
  }

  /// @nexus.proto "temporal.api.streamservice.v1.AppendRecordsResponse"
  record append-records-response {
    first-offset: option<s64>,
    last-offset: option<s64>,
  }

  // A close carries no value, so code that has a last value publishes it first.
  /// @nexus.doc "Close a Stream. Readers drain what is left, then end. Later appends are refused."
  /// @nexus.proto "temporal.api.streamservice.v1.CloseStreamRequest"
  record close-stream-request {
    ref: stream-ref,
    // The SDK Stores read only the Producer. The server also reads the withdrawal fields.
    /// @nexus.source targets="workflow" python="workflow_writer()"
    ///   typescript="workflowWriter()" dotnet="StreamWorkflowContext.Writer()"
    /// @nexus.source targets="client" python="client_writer()" typescript="clientWriter()"
    ///   dotnet="StreamActivityContext.Writer()"
    writer: option<stream-writer>,
    /// @nexus.omit
    namespace: placeholder,
    // Native only. The SDK Stores don't read it.
    /// @nexus.omit
    task-token: placeholder,
  }

  /// @nexus.proto "temporal.api.streamservice.v1.CloseStreamResponse"
  record close-stream-response {
  }

  /// @nexus.proto "temporal.api.enums.v1.StreamReadStart"
  enum stream-read-start {
    stream-read-start-unspecified,
    stream-read-start-beginning,
    stream-read-start-end,
  }

  /// @nexus.doc "Read Records from an offset."
  /// @nexus.proto "temporal.api.streamservice.v1.ReadRecordsRequest"
  record read-records-request {
    ref: stream-ref,
    /// @nexus.doc "Start offset. Empty uses start. An offset past the newest one + 1 fails."
    from-offset: option<s64>,
    /// @nexus.doc "Where to start when from-offset is empty. Unspecified is the beginning."
    start: option<stream-read-start>,
    /// @nexus.doc
    ///   "About this many items per page, 1 to 1000. A Superseded item stays with its Record."
    max-records: option<s32>,
    /// @nexus.doc "How long to wait for a new Record before an empty answer. At most 60 s."
    wait: option<duration>,
    /// @nexus.doc "How long to wait for an uncreated Stream. Empty fails at once. At most 60 s."
    create-wait: option<duration>,
    // Replay needs a fixed range, so the Workflow API omits `last`.
    /// @nexus.doc "Read the newest this many Records, oldest first. No from-offset. No wait."
    /// @nexus.api-omit targets="workflow"
    last: option<s32>,
    /// @nexus.doc "The maximum Record bytes in a page. A larger Record is still returned alone."
    max-bytes: option<s64>,
    /// @nexus.omit
    namespace: placeholder,
    // Native only. The SDK Stores refuse to-offset and wake-only.
    /// @nexus.omit
    to-offset: placeholder,
    /// @nexus.omit
    wake-only: placeholder,
    /// @nexus.omit
    floor-from: placeholder,
  }

  /// @nexus.proto "temporal.api.streamservice.v1.ReadRecordsResponse"
  record read-records-response {
    records: list<stream-record>,
    /// @nexus.doc "The from-offset of the next read, which is the newest offset read + 1."
    next-offset: option<s64>,
    /// @nexus.doc "True when the Stream is closed and this read gave its last item."
    done: option<bool>,
    // Native only. The SDK Stores never set it.
    /// @nexus.omit
    continue-as-new-suggested: placeholder,
  }

  /// @nexus.proto "temporal.api.streamservice.v1.DescribeStreamRequest"
  record describe-stream-request {
    ref: stream-ref,
    /// @nexus.omit
    namespace: placeholder,
  }

  /// @nexus.proto "temporal.api.streamservice.v1.DescribeStreamResponse"
  record describe-stream-response {
    status: option<stream-status>,
    /// @nexus.doc "The newest offset, of a Record or a Superseded item. Empty for none."
    last-offset: option<s64>,
    retention: option<duration>,
  }

  // A stream never changes, since offsets are values that its methods return. Only a create's
  // response sets created, so a stream built from a ref has none.
  /// @nexus.doc "One Stream. Build it from a stream-ref, or get it from a create."
  /// @nexus.type-parameter "body-t"
  /// @nexus.flatten-in-api param="ref" fields="id backend" keep=true
  resource %stream {
    constructor(ref: stream-ref, created: option<bool>);

    /// @nexus.doc "Publish values, and return the offset of the last one."
    /// @nexus.operation "append-records"
    /// @nexus.varargs name="values"
    /// @nexus.result-field "last-offset"
    publish: func(records: list<append-record>) -> append-records-response;

    /// @nexus.doc "Close the Stream. Readers drain what is left, then end."
    /// @nexus.operation "close-stream"
    /// @nexus.close
    close: func();

    /// @nexus.doc "Read one page of Records. The poll iterator reads them all."
    /// @nexus.operation "read-records"
    read: func(
      from-offset: option<s64>,
      start: option<stream-read-start>,
      max-records: option<s32>,
      wait: option<duration>,
      create-wait: option<duration>,
      max-bytes: option<s64>,
    ) -> read-records-response;

    /// @nexus.doc "Describe the Stream's status, newest offset and Retention."
    /// @nexus.operation "describe-stream"
    describe: func() -> describe-stream-response;
  }

  // With use-existing, created is false when the Stream existed, whatever its Retention.
  /// @nexus.proto "temporal.api.streamservice.v1.CreateStreamResponse"
  type create-stream-result = own<%stream>;

  /// @nexus.operation name="CreateStream"
  create-stream: func(request: create-stream-request) -> create-stream-result;

  /// @nexus.doc "Append one batch. Workflow code makes the call from a Local Activity."
  /// @nexus.operation name="AppendRecords"
  append-records: func(request: append-records-request) -> append-records-response;

  /// @nexus.operation name="CloseStream"
  close-stream: func(request: close-stream-request) -> close-stream-response;

  // A WIT stream can't cross a Nexus call, so a read is a request and a response. The SDK's support
  // helper builds the next request from a page for the poll iterator.
  /// @nexus.doc
  ///   "A long poll. NOT_FOUND for an uncreated Stream. Workflow code reads from a Local Activity."
  /// @nexus.operation name="ReadRecords"
  /// @nexus.poll python="next_read_request" typescript="nextReadRequest"
  ///   dotnet="StreamPoll.NextReadRequest" items="records" python-resume="resume_read_request"
  ///   targets="client"
  read-records: func(request: read-records-request) -> read-records-response;

  /// @nexus.operation name="DescribeStream"
  describe-stream: func(request: describe-stream-request) -> describe-stream-response;

  // No operation returns these. A failed call has one in its details. Each SDK raises the class
  // of its reason, or the base class for a reason with no class.
  /// Why a Stream call failed. Each reason has one gRPC status code.
  /// @nexus.proto "temporal.api.enums.v1.StreamErrorReason"
  /// @nexus.error details="stream-error-details" field="reason" name="stream-error"
  ///   python-extends="temporalio.exceptions.ApplicationError"
  ///   typescript-extends="ApplicationFailure" typescript-extends-import="@temporalio/common"
  ///   dotnet-extends="Temporalio.Exceptions.ApplicationFailureException"
  enum stream-error-reason {
    /// @nexus.fallback
    stream-error-reason-unspecified,
    /// @nexus.error
    stream-error-reason-not-found,
    /// @nexus.error
    stream-error-reason-expired,
    /// @nexus.error
    stream-error-reason-closed,
    /// @nexus.error
    stream-error-reason-fenced,
    stream-error-reason-sequence-too-low,
    /// @nexus.error
    stream-error-reason-seq-divergent,
    /// @nexus.error
    stream-error-reason-not-owner,
    stream-error-reason-format-too-new,
    /// @nexus.error
    stream-error-reason-offset-too-high,
    /// @nexus.error
    stream-error-reason-too-large,
    stream-error-reason-invalid,
    /// @nexus.error retryable=true
    stream-error-reason-storage-unavailable,
    stream-error-reason-unknown-writer,
    /// @nexus.error
    stream-error-reason-unsupported,
    /// @nexus.error
    stream-error-reason-already-exists,
    stream-error-reason-storage-corrupt,
  }

  /// @nexus.doc "The details of a failed Stream call."
  /// @nexus.proto "temporal.api.stream.v1.StreamErrorDetails"
  record stream-error-details {
    reason: option<stream-error-reason>,
  }
}
